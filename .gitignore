# ==============================================================================
# GIO Os - Git Ignore Configuration
# ==============================================================================

# Compiled OS images & Virtual disks (Exceeded GitHub commit size limits)
dist/*.iso
dist/*.qcow2
dist/*.img
dist/*.raw
dist/*.bin

# Build workspace & Chroot mountpoints
build/workspace/
workspace/
*.squashfs
filesystem.squashfs

# Node.js & Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# System & Editor temporary files
.DS_Store
Thumbs.db
*.swp
*~
*.bak
*.tmp
.idea/
.vscode/
